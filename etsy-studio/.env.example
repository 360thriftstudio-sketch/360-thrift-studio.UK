# Copy to .env and fill in locally. Never paste these values into a chat or commit them.

# From https://www.etsy.com/developers/your-apps
ETSY_KEYSTRING=replace_me
ETSY_SHARED_SECRET=replace_me
# Must match the callback registered on your Etsy app exactly.
ETSY_REDIRECT_URI=https://localhost:3003/oauth/callback
ETSY_AUTH_PORT=3003
# Read scopes are always requested. Set to 1 only when you are ready for the draft lister
# (create drafts, upload images/files, publish on explicit confirmation). Changing it needs `npm run auth` again.
ETSY_ENABLE_WRITES=0
# Months of receipt history to synchronise.
SYNC_RECEIPT_MONTHS=24

DASHBOARD_PORT=3000

# Krafie MCP (research, image/video generation). Log in once with `krafie-mcp login`; the CLI keeps its own token.
KRAFIE_MCP_COMMAND=krafie-mcp
KRAFIE_MCP_ARGS=
# Comma-separated research seeds: categories, winners, occasions, recipients, styles, product types.
RESEARCH_SEEDS=

# Optional Kreatorium mockup service. The bearer token is stored in the OS vault with
# `node scripts/set-secret.js kreatorium`, never here and never in browser code.
KREATORIUM_MOCKUP_URL=

# Optional in-process refresh schedule (hours, 0 = off). Timers stop when the dashboard stops.
SCHEDULE_ETSY_HOURS=0
SCHEDULE_RESEARCH_HOURS=0

# Token vault backend: auto | dpapi | keychain | secret-tool
STUDIO_VAULT=auto
