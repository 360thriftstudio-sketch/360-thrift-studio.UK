{
  "name": "etsy-seller-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Etsy seller studio: shop analytics, SEO audits, keyword research, creative workspace and a draft-first Etsy lister.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "cert": "node scripts/cert.js",
    "ping": "node src/ping.js",
    "auth": "node src/auth-server.js",
    "sync": "node src/sync.js",
    "research:sync": "node src/research-sync.js",
    "dashboard": "node src/dashboard-server.js",
    "demo": "node scripts/demo-seed.js && node src/dashboard-server.js",
    "demo:seed": "node scripts/demo-seed.js",
    "demo:public": "node scripts/public-demo.js",
    "demo:static": "node scripts/build-static-demo.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec tests/*.test.js"
  }
}
