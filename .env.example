# Postgres (Neon, Supabase or Render). Local: docker compose up postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/thrift360
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Shows a "preview" banner and noindex on preview deployments
NEXT_PUBLIC_PREVIEW_MODE=false
# Staff inbox for new RFQ / enquiry emails (optional)
STAFF_EMAIL=
# Seed: first admin login (only used by `pnpm seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
